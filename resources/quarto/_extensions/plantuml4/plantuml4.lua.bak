-- PlantUML filter for Quarto/Pandoc

local DEFAULT_SERVER = "http://plantuml.local:1025"
local DEFAULT_FORMAT = "svg"

local function trim_trailing_slash(value)
  return (value:gsub("/+$", ""))
end

local function hex_encode(value)
  return (value:gsub(".", function(character)
    return string.format("%02x", string.byte(character))
  end))
end

local function has_class(block, class_name)
  for _, value in ipairs(block.classes) do
    if value == class_name then
      return true
    end
  end

  return false
end

local function caption_to_inlines(caption)
  if caption == nil or caption == "" then
    return pandoc.Inlines({})
  end

  local document = pandoc.read(caption, "markdown")
  local inlines = pandoc.Inlines({})

  for _, block in ipairs(document.blocks) do
    if block.t == "Para" or block.t == "Plain" then
      if #inlines > 0 then
        inlines:insert(pandoc.Space())
      end

      inlines:extend(block.content)
    end
  end

  return inlines
end

local function copy_image_attributes(block)
  local attributes = {}

  for key, value in pairs(block.attributes) do
    if key ~= "server"
      and key ~= "format"
      and key ~= "fig-cap"
      and key ~= "caption"
      and key ~= "label"
    then
      attributes[key] = value
    end
  end

  return attributes
end

local function resolve_identifier(block)
  if block.identifier ~= nil and block.identifier ~= "" then
    return block.identifier
  end

  return block.attributes["label"] or ""
end

local function resolve_caption(block)
  return block.attributes["fig-cap"]
    or block.attributes["caption"]
    or ""
end

local function fetch_diagram(server, format, source)
  local encoded = "~h" .. hex_encode(source)
  local url = trim_trailing_slash(server) .. "/" .. format .. "/" .. encoded

  local ok, mime_type, contents = pcall(pandoc.mediabag.fetch, url)

  if not ok then
    error(
      "No se pudo obtener el diagrama desde PlantUML Server.\n"
        .. "URL: "
        .. url
        .. "\n"
        .. "Detalle: "
        .. tostring(mime_type)
    )
  end

  if contents == nil or contents == "" then
    error("PlantUML Server devolvió una respuesta vacía: " .. url)
  end

  return mime_type, contents
end

function CodeBlock(block)
  if not has_class(block, "plantuml") then
    return nil
  end

  local server = block.attributes["server"] or DEFAULT_SERVER
  local format = block.attributes["format"] or DEFAULT_FORMAT

  if format ~= "svg" then
    error(
      "Formato PlantUML no soportado en esta versión: "
        .. tostring(format)
        .. ". Use format=\"svg\"."
    )
  end

  local mime_type, contents = fetch_diagram(server, format, block.text)

  if mime_type == nil or mime_type == "" then
    mime_type = "image/svg+xml"
  end

  local digest = pandoc.utils.sha1(block.text .. "\n" .. server .. "\n" .. format)
  local image_path = "plantuml/" .. digest .. "." .. format

  pandoc.mediabag.insert(image_path, mime_type, contents)

  local caption = caption_to_inlines(resolve_caption(block))
  local identifier = resolve_identifier(block)
  local attributes = copy_image_attributes(block)
  local image_attr = pandoc.Attr(identifier, {}, attributes)

  local image = pandoc.Image(caption, image_path, "", image_attr)

  return pandoc.Para({ image })
end
